FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /api ./cmd/api

FROM alpine:3.20
WORKDIR /app
COPY --from=builder /api /app/api
COPY backend/migrations /app/migrations
EXPOSE 8080
CMD ["/app/api"]
